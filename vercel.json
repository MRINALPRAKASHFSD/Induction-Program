{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "routes": [
    { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    },
    "api/attendance-mark.ts": {
      "maxDuration": 30
    },
    "api/attendance-worker.ts": {
      "maxDuration": 30
    }
  }
}
