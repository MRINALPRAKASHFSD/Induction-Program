rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isValidStudent() {
      let data = request.resource.data;
      return data.keys().hasAll(['full_name', 'course', 'created_at'])
          && data.full_name is string
          && data.course is string;
    }

    function isAttendanceValid(docId) {
      let data = request.resource.data;
      return data.keys().hasAll(['event_id', 'student_id', 'scanned_at'])
          && data.event_id is string
          && data.student_id is string
          && docId == (data.event_id + '_' + data.student_id);
    }

    function isClubRegistrationValid(docId) {
      let data = request.resource.data;
      return data.keys().hasAll(['club_id', 'student_id', 'registered_at'])
          && data.club_id is string
          && data.student_id is string
          && docId == (data.club_id + '_' + data.student_id);
    }
    
    // 1. EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow write: if false; 
    }
    
    // 2. STUDENTS
    match /students/{enrollmentId} {
      allow get: if true; 
      allow list: if request.auth != null && (request.auth.token.role == 'super_admin' || request.auth.token.role == 'coordinator');
      allow create: if isValidStudent();
      allow update: if 
        // 1. Department ID cannot be changed (Lock)
        request.resource.data.department_id == resource.data.department_id &&
        // 2. Points can only be updated if they increment by 5, 10 or 25
        (request.resource.data.points == resource.data.points + 5 || 
         request.resource.data.points == resource.data.points + 10 || 
         request.resource.data.points == resource.data.points + 25 ||
         request.resource.data.points == resource.data.points) &&
        // 3. Other core fields cannot be changed
        request.resource.data.enrollment_no == resource.data.enrollment_no &&
        request.resource.data.full_name == resource.data.full_name;
      allow delete: if false;
      
      match /private/contact {
        allow get: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/students/$(enrollmentId)).data.auth_uid;
        allow list: if false;
        allow create, update: if true; // We can restrict this further based on auth_uid if needed, but for registration we allow create.
        allow delete: if false;
      }
    }
    
    // 3. ATTENDANCE
    match /attendance/{docId} {
      allow get: if true;
      allow list: if request.auth != null && (request.auth.token.role == 'super_admin' || request.auth.token.role == 'coordinator');
      allow create: if isAttendanceValid(docId); // Enforces schema and composite ID
      allow update, delete: if false; // Immutable once recorded
    }
    
    // 4. CLUBS
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 5. CLUB REGISTRATIONS
    match /club_registrations/{regId} {
      allow get: if true;
      allow list: if request.auth != null && (request.auth.token.role == 'super_admin' || request.auth.token.role == 'coordinator');
      allow create: if isClubRegistrationValid(regId); // Enforces schema and composite ID
      allow update, delete: if false;
    }

    // 6. CLUB EVENTS & ATTENDANCE
    match /club_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /club_attendance/{docId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAttendanceValid(docId); 
      allow update, delete: if false;
    }

    // 7. ADMINS
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // 8. SECURE DOCUMENTS
    match /secure_documents/{docId} {
      // Allow super_admin and coordinator to read
      allow read: if request.auth != null && (request.auth.token.role == 'super_admin' || request.auth.token.role == 'coordinator');
      // Allow coordinator and super_admin to upload document metadata
      allow create: if request.auth != null && (request.auth.token.role == 'coordinator' || request.auth.token.role == 'super_admin');
      // Allow updates for soft deletes/restores
      allow update: if request.auth != null && (request.auth.token.role == 'coordinator' || request.auth.token.role == 'super_admin');
      allow delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // 9. USERS (RBAC)
    match /users/{userId} {
      // Allow a user to read their own profile, or super_admin to read all
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'super_admin');
      // Only super_admin can create/update users
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // 10. AUDIT LOGS
    match /audit_logs/{logId} {
      // Only super admin can read the audit logs
      allow read: if request.auth != null && request.auth.token.role == 'super_admin';
      allow create: if request.auth != null;
      allow update, delete: if false; // Immutable logs
    }
  }
}
